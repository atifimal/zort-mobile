# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env*.local

# typescript
*.tsbuildinfo

# generated native folders
/ios
/android

# Android C++ build directory on Windows (plugins/with-short-cxx-dir.js)
/.cx

# Build output of local native modules
modules/*/android/build/
modules/*/android/.cxx/

# AI assistant files (Claude Code settings, agent instructions)
.claude/
CLAUDE.md
CLAUDE.local.md
AGENTS.md

# IDE
.idea/

# Signing keys: the upload key lives outside the project (see README); never commit one
*.jks
*.keystore
!android/app/debug.keystore
