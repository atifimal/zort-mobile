<?xml version="1.0" encoding="utf-8"?>
<!-- A row's pressed state; rows are otherwise see-through on the card -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android" android:color="@color/qa_row_pressed">
  <item android:id="@android:id/mask">
    <shape android:shape="rectangle">
      <solid android:color="#FFFFFFFF" />
      <corners android:radius="12dp" />
    </shape>
  </item>
</ripple>
