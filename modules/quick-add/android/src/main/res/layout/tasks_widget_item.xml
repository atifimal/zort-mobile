<?xml version="1.0" encoding="utf-8"?>
<!-- A row of the Tasks widget: the check circle (checks the task off) and the task (opens it).
     Colors are fixed in the layout and chosen by visibility; see TasksWidgetService. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
  android:layout_width="match_parent"
  android:layout_height="wrap_content"
  android:gravity="center_vertical"
  android:minHeight="52dp"
  android:orientation="horizontal">

  <FrameLayout
    android:id="@+id/task_check"
    android:layout_width="44dp"
    android:layout_height="48dp"
    android:background="@drawable/tasks_row_background">

    <ImageView
      android:id="@+id/task_ring"
      android:layout_width="24dp"
      android:layout_height="24dp"
      android:layout_gravity="center"
      android:importantForAccessibility="no"
      android:src="@drawable/ic_task_ring" />

    <ImageView
      android:id="@+id/task_ring_late"
      android:layout_width="24dp"
      android:layout_height="24dp"
      android:layout_gravity="center"
      android:importantForAccessibility="no"
      android:src="@drawable/ic_task_ring_late"
      android:visibility="gone" />
  </FrameLayout>

  <LinearLayout
    android:id="@+id/task_body"
    android:layout_width="0dp"
    android:layout_height="wrap_content"
    android:layout_weight="1"
    android:background="@drawable/tasks_row_background"
    android:gravity="center_vertical"
    android:minHeight="48dp"
    android:orientation="vertical"
    android:paddingStart="4dp"
    android:paddingTop="6dp"
    android:paddingEnd="8dp"
    android:paddingBottom="6dp">

    <TextView
      android:id="@+id/task_title"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:ellipsize="end"
      android:maxLines="2"
      android:textColor="@color/qa_text"
      android:textSize="15sp" />

    <LinearLayout
      android:id="@+id/task_meta"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:layout_marginTop="1dp"
      android:gravity="center_vertical"
      android:orientation="horizontal">

      <TextView
        android:id="@+id/task_due"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:textColor="@color/qa_text_secondary"
        android:textSize="12sp" />

      <TextView
        android:id="@+id/task_due_today"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="sans-serif-medium"
        android:maxLines="1"
        android:textColor="@color/qa_accent"
        android:textSize="12sp"
        android:visibility="gone" />

      <TextView
        android:id="@+id/task_due_late"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="sans-serif-medium"
        android:maxLines="1"
        android:textColor="@color/qa_danger"
        android:textSize="12sp"
        android:visibility="gone" />

      <ImageView
        android:id="@+id/task_repeat"
        android:layout_width="13dp"
        android:layout_height="13dp"
        android:layout_marginStart="5dp"
        android:contentDescription="@string/tasks_widget_repeats"
        android:src="@drawable/ic_task_repeat"
        android:visibility="gone" />
    </LinearLayout>
  </LinearLayout>
</LinearLayout>
