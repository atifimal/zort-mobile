<?xml version="1.0" encoding="utf-8"?>
<!-- What the widget picker shows (Android 12+): the widget with three example tasks -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
  android:id="@android:id/background"
  android:layout_width="match_parent"
  android:layout_height="match_parent"
  android:background="@drawable/quick_add_widget_background"
  android:orientation="vertical"
  android:paddingHorizontal="8dp"
  android:paddingTop="8dp"
  android:paddingBottom="4dp">

  <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="48dp"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingHorizontal="6dp">

    <ImageView
      android:layout_width="30dp"
      android:layout_height="30dp"
      android:scaleType="fitCenter"
      android:src="@drawable/quick_add_logo" />

    <LinearLayout
      android:layout_width="0dp"
      android:layout_height="wrap_content"
      android:layout_marginStart="10dp"
      android:layout_weight="1"
      android:orientation="vertical">

      <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="sans-serif-medium"
        android:text="@string/tasks_widget_title"
        android:textColor="@color/qa_text"
        android:textSize="17sp" />

      <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/tasks_widget_sample_count"
        android:textColor="@color/qa_text_secondary"
        android:textSize="12sp" />
    </LinearLayout>

    <ImageView
      android:layout_width="44dp"
      android:layout_height="44dp"
      android:background="@drawable/tasks_add_button"
      android:padding="10dp"
      android:src="@drawable/ic_task_add" />
  </LinearLayout>

  <include layout="@layout/tasks_widget_preview_row_1" />
  <include layout="@layout/tasks_widget_preview_row_2" />
  <include layout="@layout/tasks_widget_preview_row_3" />
</LinearLayout>
