<?xml version="1.0" encoding="utf-8"?>
<resources>
  <!-- The quick-add window: see-through, so the home screen stays visible behind the sheet.
       The scrim is the window background, so it's there at once, before React Native draws. -->
  <style name="Theme.Zort.QuickAdd" parent="Theme.AppCompat.DayNight.NoActionBar">
    <item name="android:windowIsTranslucent">true</item>
    <item name="android:windowBackground">@color/qa_scrim</item>
    <item name="android:windowNoTitle">true</item>
    <item name="android:windowContentOverlay">@null</item>
    <item name="android:backgroundDimEnabled">false</item>
    <item name="android:windowAnimationStyle">@null</item>
    <item name="android:statusBarColor">@android:color/transparent</item>
    <item name="android:navigationBarColor">@android:color/transparent</item>
  </style>

  <!-- Widget pieces, shared by its regular and compact layouts -->
  <style name="QuickAddWidget" />

  <style name="QuickAddWidget.Bar">
    <item name="android:layout_width">match_parent</item>
    <item name="android:layout_height">wrap_content</item>
    <item name="android:layout_gravity">center_vertical</item>
    <item name="android:background">@drawable/quick_add_widget_background</item>
    <item name="android:gravity">center_vertical</item>
    <item name="android:orientation">horizontal</item>
    <item name="android:padding">6dp</item>
  </style>

  <style name="QuickAddWidget.Button">
    <item name="android:layout_width">0dp</item>
    <item name="android:layout_height">48dp</item>
    <item name="android:layout_marginHorizontal">3dp</item>
    <item name="android:layout_weight">1</item>
    <item name="android:gravity">center</item>
    <item name="android:orientation">horizontal</item>
    <item name="android:paddingHorizontal">8dp</item>
  </style>

  <style name="QuickAddWidget.Icon">
    <item name="android:layout_width">20dp</item>
    <item name="android:layout_height">20dp</item>
    <item name="android:importantForAccessibility">no</item>
  </style>

  <style name="QuickAddWidget.Label">
    <item name="android:layout_width">wrap_content</item>
    <item name="android:layout_height">wrap_content</item>
    <item name="android:layout_marginStart">6dp</item>
    <item name="android:ellipsize">end</item>
    <item name="android:fontFamily">sans-serif-medium</item>
    <item name="android:importantForAccessibility">no</item>
    <item name="android:maxLines">1</item>
    <item name="android:textSize">14sp</item>
  </style>
</resources>
